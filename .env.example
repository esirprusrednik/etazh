# Домен приложения (DNS A-запись должна указывать на сервер)
DOMAIN=etazh.example.ru
BASE_URL=https://etazh.example.ru

# Секреты: node scripts/gen-secrets.js >> .env
EMAIL_PEPPER=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.ru

# Кто может входить и кто модератор
ALLOWED_DOMAINS=mts.ru
ADMIN_EMAILS=

# Почта для ссылок входа: console (ссылка в логе) или smtp
MAIL_MODE=smtp
SMTP_HOST=smtp.example.ru
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Этаж <no-reply@etazh.example.ru>

SECURE_COOKIES=true
WELCOME_BEANS=50
