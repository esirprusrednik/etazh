{
	# Журнал запросов (IP-адреса посетителей) не ведём — только ошибки самого Caddy
	log default {
		output stderr
		level ERROR
	}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}
